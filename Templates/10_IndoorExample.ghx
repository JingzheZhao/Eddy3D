  private static Dictionary&lt;string, Dictionary&lt;string, string&gt;&gt; GetFixedValue()
  {
    Dictionary&lt;string, Dictionary&lt;string, string&gt;&gt; Dict = new Dictionary&lt;string, Dictionary&lt;string, string&gt;&gt;();

    Dictionary&lt;string, string&gt; InternalDict = new Dictionary&lt;string, string&gt;();

    Dict.Add("test", InternalDict);



      InternalDict.Add("type", "fixedValue");
      InternalDict.Add("value", "uniform (" + new Vector3d(1,2,3).ToString().Trim(',') + ")");
     

    return Dict;
  }</item>
