                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    if(!Directory.Exists(folder)){  Directory.CreateDirectory(folder);}

    if (download == true){

      DownLoadFile(epwURL, folder + "\\weather.epw");



    }

    path = folder + "\\weather.epw";</item>
