                    <item name="ScriptSource" type_name="gh_string" type_code="10">






    String filePath = path + @"\system\" + fileName;


    A = filePath;



    File.Delete(filePath);

    using(var tw = new StreamWriter(filePath)) // new StreamWriter(path, true) for append
    {
      tw.Write(@"// * * * * * * * * * //
        FoamFile
        {
        version 0.5;
        format ascii;
        root ""ROOT"";
        case ""CASE"";

        class dictionary;
        object xxx;
        }
        method scotch;
        numberOfSubdomains 8;
        scotchCoeffs
        {
        }"


        );








      tw.Close();


    }








</item>
                    <item name="UsingSource" type_name="gh_string" type_code="10">using System.IO;
