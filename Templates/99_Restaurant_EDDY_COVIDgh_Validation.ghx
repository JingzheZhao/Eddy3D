                    <item name="ScriptSource" type_name="gh_string" type_code="10">    GH_Document gh_d = owner.OnPingDocument();

    if (gh_d.IsFilePathDefined)
    {
      Print("A path is defined.");
      A = System.IO.Path.GetDirectoryName(gh_d.FilePath);
    }
    else
    {
      Print("No path defined.");
    }
