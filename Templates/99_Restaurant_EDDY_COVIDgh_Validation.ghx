                    <item name="ScriptSource" type_name="gh_string" type_code="10">

    //var dom = (EddyLib.Indoor.IndoorDomain) x;

    double refLevel = 3;

    Point3d pt = new Point3d(1, 1, 1);

    Point3d pt0 = new Point3d(0, 0, 0);
    Point3d pt1 = new Point3d(10, 10, 10);
    BoundingBox boundingB = new BoundingBox(pt0, pt1);

    EddyLib.Indoor.IndoorBC.Inlet inl = (EddyLib.Indoor.IndoorBC.Inlet) i;
    EddyLib.Indoor.IndoorBC.Outlet outl = (EddyLib.Indoor.IndoorBC.Outlet) o;
    EddyLib.Indoor.IndoorBC.Wall wall = (EddyLib.Indoor.IndoorBC.Wall) w;

    inl.Id = "Inlet_1";
    outl.Id = "Outlet_1";
    wall.Id = "Wall_1";

    List &lt; EddyLib.Indoor.IndoorBC.Inlet &gt; inlList = new List &lt; EddyLib.Indoor.IndoorBC.Inlet &gt; ();
    inlList.Add(inl);


    List &lt; EddyLib.Indoor.IndoorBC.Outlet &gt; outlList = new  List &lt; EddyLib.Indoor.IndoorBC.Outlet &gt; (){outl};


    List &lt; EddyLib.Indoor.IndoorBC.Wall &gt; wallList = new List &lt; EddyLib.Indoor.IndoorBC.Wall &gt;(){wall};

    var res = new SnappyHexMeshDict(refLevel, pt, boundingB, inlList, outlList, wallList);

    A = res.FullDictString.ToString();</item>
