                    <item name="ScriptSource" type_name="gh_string" type_code="10">






    String filePath = path + @"\" + fileName;


    A = filePath;



    File.Delete(filePath);

    using(var tw = new StreamWriter(filePath)) // new StreamWriter(path, true) for append
    {
      tw.Write(@"call ""C:\Program Files\blueCFD-Core-2017\\setvars.bat""
        set PATH=%HOME%msys64\usr\bin;%PATH%
        cd " + path + @"

        renumberMesh -overwrite
        decomposePar -force
        mpiexec -np 8 buoyantSimpleFoam -parallel
        reconstructPar");






      tw.Write("\"");
      tw.WriteLine("\n");
      tw.WriteLine("PAUSE");


      tw.Close();


    }








</item>
