                    <item name="AdditionalSource" type_name="gh_string" type_code="10">  public  class SnappyHexMeshDict : EddyLib.Indoor.Dicts.GenericDict
  {
    private Point3d locationInMesh;


    //public List&lt;String&gt; InternalDict = new List&lt;string&gt;();


    //public Dictionary&lt;string, dynamic&gt; GeometryDict { get; set; }

  public Dictionary&lt;string, dynamic&gt; GeometrySubDict { get; set; }


  public SnappyHexMeshDict(double refineMentLevel, Point3d pointInsideDomain, BoundingBox BBox, List&lt;EddyLib.Indoor.IndoorBC.Inlet&gt; inlet, List&lt;EddyLib.Indoor.IndoorBC.Outlet&gt; outlet, List&lt;EddyLib.Indoor.IndoorBC.Wall&gt; wall)
  {
    this.DictionaryName = "snappyHexMeshDict";
    this.Location = DictLocation.system;
    this.FC = FieldClass.dictionary;
    this.Header = GetHeader(this);
    this.locationInMesh = pointInsideDomain;

    this.GeometrySubDict = new Dictionary&lt;string, dynamic&gt;();

    foreach (IndoorBC i in inlet) { this.GeometrySubDict.Add(i.Id.ToString(), GetGeometryDict(i)); };
    foreach (IndoorBC i in outlet) { this.GeometrySubDict.Add(i.Id.ToString(), GetGeometryDict(i)); };
    foreach (IndoorBC i in wall) { this.GeometrySubDict.Add(i.Id.ToString(), GetGeometryDict(i)); };

    //this.GeometryDict = new Dictionary&lt;string, dynamic&gt;();
    //GeometryDict.Add("geometry", GeometrySubDict);


    //  this.InternalDict.Add(CppMapSerializerDyn2.Serialize(GetSettingsDict()));
    //  this.InternalDict.Add(CppMapSerializerDyn2.Serialize(this.GeometryDict));
    //  this.InternalDict.Add(CppMapSerializerDyn2.Serialize(GetSnapControlsDict()));
    //  this.InternalDict.Add(CppMapSerializerDyn2.Serialize(GetCastellatedMeshControls(this.locationInMesh, wall, inlet, outlet)));
    //  this.InternalDict.Add(CppMapSerializerDyn2.Serialize(GetAddLayersControls()));
    //  this.InternalDict.Add(CppMapSerializerDyn2.Serialize(GetMeshQualityControls()));


    //  string[] parts = { this.Header, "\n",
    //    String.Join("\n", this.InternalDict.ToArray())
    //    };


    string[] parts = { this.Header, "\n",
      CppMapSerializerDyn2.Serialize(GetSettingsDict()),"\n",
      CppMapSerializerDyn2.Serialize(this.GeometrySubDict),"\n",
      //        CppMapSerializerDyn2.Serialize(GetSnapControlsDict()),"\n",
      //        CppMapSerializerDyn2.Serialize(GetCastellatedMeshControls(this.locationInMesh, wall, inlet, outlet)),"\n",
      //        CppMapSerializerDyn2.Serialize(GetAddLayersControls()),"\n",
      //        CppMapSerializerDyn2.Serialize(GetMeshQualityControls()),"\n"
      };

    this.FullDictString = parts.Aggregate((partialPhrase, word) =&gt; "{partialPhrase} {word}");
  }


  public static Dictionary&lt;string,dynamic&gt; GetGeometryDict(IndoorBC input)
  {

    Dictionary &lt; string, dynamic&gt; Dict = new Dictionary&lt;string, dynamic&gt;();

    Dictionary &lt; string, dynamic&gt; InternalDict = new Dictionary&lt;string, dynamic&gt;();

    Dict.Add(input.Id + ".stl", InternalDict);

    InternalDict.Add("type", input.OFGeometryType);
    InternalDict.Add("name", input.Id);

    return Dict;
  }

  public static Dictionary&lt;string, dynamic&gt; GetSettingsDict()
  {
    Dictionary &lt; string, dynamic&gt; InternalDict = new Dictionary&lt;string, dynamic&gt;();

    InternalDict.Add("castellatedMesh", "true");
    InternalDict.Add("snap", "true");
    InternalDict.Add("addLayers", "false");
    InternalDict.Add("singleRegionName", " true");
    InternalDict.Add("mergePatchFaces", "true");
    InternalDict.Add("keepPatches", "false");
    InternalDict.Add("mergeTolerance", "1e-8");
    InternalDict.Add("debug", "0");

    return InternalDict;
  }

}


public class CppMapSerializerDyn2
{
  public static string Serialize(Dictionary&lt;string, dynamic&gt; dict)
  {
    StringBuilder sb = new StringBuilder();

    foreach (KeyValuePair&lt;string, dynamic&gt; evl in dict)
    {
      // 0. Dictionary&lt;string, List&lt;Dictionary&lt;string, Dictionary&lt;string, string&gt;&gt;&gt;&gt; dicts

      if (evl.Key is String &amp;&amp; evl.Value is Dictionary&lt;string, dynamic&gt;)
      {
        sb.AppendLine(Serialize(evl.Value));
      }

      // 1. Dictionary&lt;string, string&gt; dict
      else if (evl.Key is String &amp;&amp; (evl.Value is String || evl.Value is Int32))
      {
        DictToString(evl, ref sb);

      }
      // 2. Dictionary&lt;string, Dictionary&lt;string, string&gt;&gt; dicts
      //      else if (evl.Key is String &amp;&amp; evl.Value is Dictionary&lt;string, dynamic&gt;)
      //      {
      //        sb.AppendLine(Serialize(evl.Value));
      //      }


    }

    return sb.ToString();
  }

  private static void DictToString(string name, Dictionary&lt;string, dynamic&gt; dict, ref StringBuilder sb)
  {
  sb.AppendLine("\t" + name);

  sb.AppendLine("\t" + "{");

  foreach (KeyValuePair&lt;string, dynamic&gt; evl in dict)
  {
  if (evl.Key is String &amp;&amp; evl.Value is String)
  {

  sb.AppendLine("\t" + "\t" + evl.Key + "\t" + evl.Value + ";");
}
                else if (evl.Key is String &amp;&amp; evl.Value is Int32)
                {
                    sb.AppendLine("\t" + "\t" + evl.Key + "\t" + evl.Value.ToString() + ";");
                }


                else if (evl.Key is String &amp;&amp; evl.Value is Dictionary&lt;string, dynamic&gt;)
                {
                    sb.AppendLine("\t" + "\t" + evl.Key);

                    sb.AppendLine("\t" + "\t" + "{");
// Problem line
                    sb.AppendLine("\t" + "\t" + "\t" + Serialize(evl.Value));

                    sb.AppendLine("\t" + "\t" + "}");
                }
            }

            sb.AppendLine("\t" + "}");
 }

private static void DictToString(KeyValuePair&lt;string, dynamic&gt; evl, ref StringBuilder sb)
        {
            if (evl.Key is String)
            {
                if (evl.Value is String)
                {
                    sb.AppendLine(evl.Key + "\t " + evl.Value + ";");
                }
                else
                {
                    sb.AppendLine(evl.Key + "\t " + evl.Value.ToString() + ";");
                }
            }
        }
}




