                <item name="GUID" type_name="gh_guid" type_code="9">a9a8ebd2-fff5-4c44-a8f5-739736d129ba</item>
                <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="10">
                    <item name="AdditionalSource" type_name="gh_string" type_code="10">  public static double Angle_3D(Vector3d A, Vector3d B, out string str_error)
  {
    
    str_error = "";
    //IL_0038: Unknown result type (might be due to invalid IL or missing references)
    //IL_0039: Unknown result type (might be due to invalid IL or missing references)
    if (!((Vector3d)( A)).Unitize())
    {
      str_error = "First vector is zero-length";
      return double.NaN;
    }
    if (!((Vector3d)( B)).Unitize())
    {
      str_error = "Second vector is zero-length";
      return double.NaN;
    }
    return Math.Acos(Math.Max(Math.Min(A * B, 1.0), -1.0));
  }</item>
                    <item name="CustomUsing" type_name="gh_bool" type_code="1">true</item>
                    <item name="Description" type_name="gh_string" type_code="10">A C#.NET scriptable component</item>
