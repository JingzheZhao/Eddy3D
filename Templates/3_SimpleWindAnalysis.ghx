              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="11">
                    <item name="CustomUsing" type_name="gh_bool" type_code="1">true</item>
                    <item name="Description" type_name="gh_string" type_code="10">A C#.NET scriptable component</item>
                    <item name="EditorPosition" type_name="gh_drawing_point" type_code="30">
                      <X>10</X>
                      <Y>71</Y>
                    </item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">2739b3be-deb9-4e5c-9c72-526461df0a04</item>
                    <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">C#</item>
                    <item name="OutParameter" type_name="gh_bool" type_code="1">true</item>
                    <item name="Reference" index="0" type_name="gh_string" type_code="10">C:\Users\pkastner\Documents\GitHub\Eddy3d\Eddy\bin\EddyLib.dll</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">1</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    var DOM = (EddyLib.OFBoxDomain) dom;

    var v = Math.Round(DOM.DomainMesh.Volume(), 1);
    var v1 = DOM.DomainMesh.Vertices[0];
    var v7_x = Math.Round(DOM.DomainMesh.Vertices[7].X, 1);
    var v7_y = Math.Round(DOM.DomainMesh.Vertices[7].Y, 1);
    var v7_z = Math.Round(DOM.DomainMesh.Vertices[7].Z, 1);

    var area1 = Math.Round(EddyLib.Utilities.MeshFaceArea(1, DOM.DomainMeshGroundPerim), 1);
    var area3 = Math.Round(EddyLib.Utilities.MeshFaceArea(3, DOM.DomainMeshGroundPerim), 1);

    A = v;
    B = v7_x;
    C = v7_y;
    D = v7_z;
    E = area1;
    F = area3;

    // Assert.True(v == 3037030.6 &amp;&amp; v7_x == 144.7 &amp;&amp; v7_y == 33.5 &amp;&amp; v7_z == 0.0 &amp;&amp; area1 == 151.5 &amp;&amp; area3 == 454.6);</item>
                    <item name="UsingSource" type_name="gh_string" type_code="10">using EddyLib;</item>
                  </items>
