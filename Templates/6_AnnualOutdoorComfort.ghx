                    <item name="ScriptSource" type_name="gh_string" type_code="10">    var tree = new DataTree&lt;double&gt;();

    var numberOfPoints = points.Count;

    for (int h = 0; h &lt; 8760 ; h++){
      List&lt;double&gt; hv = Enumerable.Repeat(MRT, numberOfPoints).ToList();
      tree.AddRange(hv, new GH_Path(h));
      //  for(int p = 0; p &lt; numberOfPoints; p++){


      //  }

    }

    A = tree;</item>
