      //this.Values[h, p] = GetMRTForPointViaKessling(weather, h, DiffRad[h][p], DirRad[h][p])[0];

      // this.dcill[h, p] = Ldcill[h][p];
      // this.dcdill[h, p] = Ldcdill[h][p];
      // this.dirill[h, p] = Ldirill[h][p];
      //  this.totalIll[h, p] = LtotalIll[h][p];


      }
