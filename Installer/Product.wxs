<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define CallBatchRunner_TargetDir=$(var.CallBatchRunner.TargetDir)?>
  <?define CallOC_TargetDir=$(var.CallOC.TargetDir)?>
  <?define EddyLib_TargetDir=$(var.EddyLib.TargetDir)?>
  <?define CallOF_TargetDir=$(var.CallOF.TargetDir)?>
  <?define CallProbes_TargetDir=$(var.CallProbes.TargetDir)?>
  <?define Eddy_TargetDir=$(var.Eddy.TargetDir)?>
  <?define CallRay_TargetDir=$(var.CallRay.TargetDir)?>
  <Product Id="*" Name="Installer" Language="1033" Version="1.0.0.0" Manufacturer="ESLab Cornell University" UpgradeCode="692e94f5-0c35-4084-b3f2-18006e9efdd1">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate />

    <Feature Id="ProductFeature" Title="Installer" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Installer" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- TODO: Remove the comments around this Component element and the ComponentRef below in order to add resources to this installer. -->
      <!-- <Component Id="ProductComponent"> -->
      <!-- TODO: Insert files, registry keys, and other resources here. -->
      <!-- </Component> -->
      <Component Id="CallBatchRunner.exe" Guid="db4203b5-39b2-4f03-801d-c2bfac7132ae">
        <File Id="CallBatchRunner.exe" Name="CallBatchRunner.exe" Source="$(var.CallBatchRunner_TargetDir)CallBatchRunner.exe" />
      </Component>
      <Component Id="CallOC.exe" Guid="d56d31ef-83c1-4ec3-9236-6094249d8832">
        <File Id="CallOC.exe" Name="CallOC.exe" Source="$(var.CallOC_TargetDir)CallOC.exe" />
      </Component>
      <Component Id="EddyLib.dll" Guid="d72ca583-cae6-4ed3-9bb8-7828f93e41a1">
        <File Id="EddyLib.dll" Name="EddyLib.dll" Source="$(var.EddyLib_TargetDir)EddyLib.dll" />
      </Component>
      <Component Id="CallOF.exe" Guid="c4326750-e0be-4490-b68d-e8db64ad36e2">
        <File Id="CallOF.exe" Name="CallOF.exe" Source="$(var.CallOF_TargetDir)CallOF.exe" />
      </Component>
      <Component Id="CallProbes.exe" Guid="c77bcb8c-5137-4047-9953-2eaba6e5745c">
        <File Id="CallProbes.exe" Name="CallProbes.exe" Source="$(var.CallProbes_TargetDir)CallProbes.exe" />
      </Component>
      <Component Id="Eddy.dll" Guid="7d24f1e4-0e04-4df9-9a9e-39cb53534666">
        <File Id="Eddy.dll" Name="Eddy.dll" Source="$(var.Eddy_TargetDir)Eddy.dll" />
      </Component>
      <Component Id="CallRay.exe" Guid="12be7a3c-4e35-4834-a8f1-bff00d2d42c3">
        <File Id="CallRay.exe" Name="CallRay.exe" Source="$(var.CallRay_TargetDir)CallRay.exe" />
      </Component>
      <Component Id="CallBatchRunner.exe.config" Guid="599d0132-d300-41ad-accd-e05f40040b6e">
        <File Id="CallBatchRunner.exe.config" Name="CallBatchRunner.exe.config" Source="$(var.CallBatchRunner_TargetDir)CallBatchRunner.exe.config" />
      </Component>
      <Component Id="CallOC.exe.config" Guid="3527c322-2b14-456c-b089-b746e663e8fd">
        <File Id="CallOC.exe.config" Name="CallOC.exe.config" Source="$(var.CallOC_TargetDir)CallOC.exe.config" />
      </Component>
      <Component Id="CallOF.exe.config" Guid="bb17aa6f-80c9-4b54-9fb6-a91b696cf967">
        <File Id="CallOF.exe.config" Name="CallOF.exe.config" Source="$(var.CallOF_TargetDir)CallOF.exe.config" />
      </Component>
      <Component Id="CallProbes.exe.config" Guid="98d1a129-5b5c-42e8-bc9e-ddc80c734257">
        <File Id="CallProbes.exe.config" Name="CallProbes.exe.config" Source="$(var.CallProbes_TargetDir)CallProbes.exe.config" />
      </Component>
      <Component Id="CallRay.exe.config" Guid="1d7f3299-0cb3-4217-802d-6d526909ea3a">
        <File Id="CallRay.exe.config" Name="CallRay.exe.config" Source="$(var.CallRay_TargetDir)CallRay.exe.config" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>