              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CustomUsing" type_name="gh_bool" type_code="1">true</item>
                    <item name="Description" type_name="gh_string" type_code="10">A C#.NET scriptable component</item>
                    <item name="EditorPosition" type_name="gh_drawing_point" type_code="30">
                      <X>18</X>
                      <Y>14</Y>
                    </item>
                    <item name="IconDisplay" type_name="gh_int32" type_code="3">1</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">28409886-3e29-4e1d-aaac-9439e2c77488</item>
                    <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">InspectProbe</item>
                    <item name="OutParameter" type_name="gh_bool" type_code="1">true</item>
                    <item name="Reference" index="0" type_name="gh_string" type_code="10">C:\EDDY3D\EddyLib.dll</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">1</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">

    EddyLib.Radiation.RProbe res = (EddyLib.Radiation.RProbe) x[si];

    var keylist = new List&lt;string&gt; ();

    var list = new List&lt;double&gt; ();

    list.AddRange(res.VFtoMaterial.Values.ToList());

