                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">1</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">

    MRT_Simulation_ResultProto res = (MRT_Simulation_ResultProto) x;

    var list = new List&lt;float&gt; ();
    list.AddRange(res.Probes[si].TotalRad);

    TotalRad = list;
    dMRT = res.Probes[si].SolarGain_dMRT;
    LMRT = res.Probes[si].LongWave_MRT;
   // MRT = res.Probes[si].</item>
                    <item name="UsingSource" type_name="gh_string" type_code="10">
using EddyLib.Radiation;
</item>
