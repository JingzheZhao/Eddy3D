# Local Eddy3D test settings.
# Copy this file to .env in the repository root, then adjust paths for your machine.

EDDY3D_RUN_OPENFOAM_TESTS=1
EDDY3D_TEST_CPUS=2
EDDY3D_BLUECFD_DIR=C:\Program Files\blueCFD-Core-2024
EDDY3D_RADIANCE_DIR=C:\Program Files\Radiance

# Optional Python overrides. Python is otherwise auto-detected from python,
# python3, or uv run --no-project python. On Windows, tests also check the
# persisted user/machine PATH and common uv install folders for Visual Studio.
# EDDY3D_PYTHON_EXE=C:\Path\To\python.exe
# EDDY3D_UV_EXE=C:\Path\To\uv.exe

# Optional integration-test switches:
# EDDY3D_RUN_EXTERNAL_TESTS=1
# EDDY3D_GAN_API_URL=https://your-gan-server.example
