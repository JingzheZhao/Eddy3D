<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12</LangVersion>
    <RootNamespace>Eddy</RootNamespace>
    <AssemblyName>Eddy</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Authors>Eddy3D</Authors>
  </PropertyGroup>

  <!-- Copy DLL to .gha (Grasshopper add-in) -->
  <Target Name="CopyAndRenameDll" AfterTargets="AfterBuild">
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFiles="$(TargetDir)$(TargetName).gha" />
  </Target>

  <!-- Bundle MetaBlock python project next to .gha so the MetaBlock component can auto-start the local API server -->
  <Target Name="BundleMetaBlock" AfterTargets="AfterBuild" Condition="Exists('$(ProjectDir)..\..\MetaBlock\api.py')">
    <ItemGroup>
      <MetaBlockFiles Include="$(ProjectDir)..\..\MetaBlock\**\*.*"
                      Exclude="$(ProjectDir)..\..\MetaBlock\.venv\**\*.*;
                               $(ProjectDir)..\..\MetaBlock\intermediate\**\*.*;
                               $(ProjectDir)..\..\MetaBlock\reports\**\*.*;
                               $(ProjectDir)..\..\MetaBlock\.git\**\*.*;
                               $(ProjectDir)..\..\MetaBlock\__pycache__\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(MetaBlockFiles)"
          DestinationFiles="@(MetaBlockFiles->'$(TargetDir)MetaBlock\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Write .ghlink file for Grasshopper library discovery -->
  <Target Name="WriteGrasshopperGhLink" AfterTargets="AfterBuild">
    <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(APPDATA)' != ''">
      <GhLinkDir>$(APPDATA)\Grasshopper\Libraries</GhLinkDir>
      <GhLinkFile>$(GhLinkDir)\Eddy3D-Dev.ghlink</GhLinkFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
      <GhLinkDir>$(HOME)/Library/Application Support/McNeel/Rhinoceros/8.0/Plug-ins/Grasshopper (b45a29b1-4343-4035-989e-044e8580d9cf)/Libraries</GhLinkDir>
      <GhLinkFile>$(GhLinkDir)/Eddy3D-Dev.ghlink</GhLinkFile>
    </PropertyGroup>
    <MakeDir Directories="$(GhLinkDir)" />
    <WriteLinesToFile File="$(GhLinkFile)" Lines="$(TargetDir)" Overwrite="true" />
  </Target>

  <!-- Copy macOS ONNX Runtime native binary from the CPU package for cross-platform support -->
  <Target Name="CopyMacOSRuntime" AfterTargets="AfterBuild">
    <PropertyGroup>
      <OrtCpuPkg>$(NuGetPackageRoot)microsoft.ml.onnxruntime/1.24.4</OrtCpuPkg>
      <MacOsNativeSrc>$(OrtCpuPkg)\runtimes\osx-arm64\native\libonnxruntime.dylib</MacOsNativeSrc>
      <MacOsNativeDst>$(TargetDir)runtimes\osx-arm64\native\</MacOsNativeDst>
    </PropertyGroup>
    <MakeDir Directories="$(MacOsNativeDst)" Condition="Exists('$(MacOsNativeSrc)')" />
    <Copy SourceFiles="$(MacOsNativeSrc)" DestinationFolder="$(MacOsNativeDst)" Condition="Exists('$(MacOsNativeSrc)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Run BuildInstaller.bat on Windows -->
  <Target Name="RunBuildInstaller" AfterTargets="AfterBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="call &quot;$(ProjectDir)..\Build\BuildInstaller.bat&quot; &quot;$(TargetDir)&quot;" IgnoreExitCode="true" />
  </Target>

  <!-- Exclude files not in the original csproj (unused/work-in-progress) -->
  <ItemGroup>
    <Compile Remove="Components\1_Wind\CompSimulation.cs" />
    <Compile Remove="Components\1_Wind\FunctionObjectDict.cs" />
    <Compile Remove="Components\1_Wind\MomentumSinkOutdoor_Component.cs" />
    <Compile Remove="Components\ProgressBarUI.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Grasshopper" Version="8.27.26019.16021" IncludeAssets="compile;build" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="MedallionShell" Version="1.6.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" ExcludeAssets="native" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="morelinq" Version="4.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EddyLib\EddyLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
