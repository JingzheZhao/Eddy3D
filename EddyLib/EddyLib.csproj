<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <RootNamespace>EddyLib</RootNamespace>
    <AssemblyName>EddyLib</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.27.26019.16021" IncludeAssets="compile;build" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="MedallionShell" Version="1.6.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="protobuf-net" Version="3.2.45" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Grasshopper">
      <HintPath>$(NuGetPackageRoot)grasshopper/8.27.26019.16021/lib/net7.0/Grasshopper.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>$(NuGetPackageRoot)grasshopper/8.27.26019.16021/lib/net7.0/GH_IO.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude files not in the original csproj (legacy/unused, would cause duplicate definitions) -->
  <ItemGroup>
    <Compile Remove="Legacy\**" />
    <Compile Remove="FunctionObjects\MomentumSink\**" />
    <Compile Remove="Indoor\Dictionary.cs" />
    <Compile Remove="Indoor\IndoorBCs.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Box.epJSON" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
